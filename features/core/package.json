{
  "name": "@genpos/core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "exports": {
    "./utils": "./src/utils/index.ts",
    "./utils/*": "./src/utils/*",
    "./modules/*": "./src/modules/*"
  },
  "typesVersions": {
    "*": {
      "utils/*": [
        "./src/utils/*/index.ts",
        "./src/utils/*.ts",
        "./src/utils/*"
      ],
      "modules/*": [
        "./src/modules/*/index.ts",
        "./src/modules/*.ts",
        "./src/modules/*"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "~5.9.3"
  }
}
