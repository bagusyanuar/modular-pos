{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "paths": {
      "@genpos/ui/*": ["./packages/ui/src/components/*/index.ts"],
      "@genpos/ui/context/*": ["./packages/ui/src/context/*/index.ts"],
      "@genpos/ui/icons": ["./packages/ui/src/icons/index.ts"],
      "@genpos/core": ["./packages/core/src/index.ts"],
      "@genpos/api": ["./packages/api/src/index.ts"]
    }
  }
}
