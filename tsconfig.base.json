{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "paths": {
      "@genpos/ui/*": ["./packages/ui/src/components/*/index.ts"],
      "@genpos/ui/context/*": ["./packages/ui/src/context/*/index.ts"],
      "@genpos/ui/icons": ["./packages/ui/src/icons/index.ts"],
      "@genpos/core/*": ["./features/core/src/*"],
      "@genpos/infrastructure/*": ["./features/infrastructure/src/*"],
      "@genpos/presentation/*": ["./features/presentation/src/*"],
      "@genpos/store/*": ["./packages/store/src/*"],
      "@genpos/api": ["./packages/api/src/index.ts"],
      "@genossys-erp/core/*": ["./modules/core/src/*"],
      "@genossys-erp/infrastructure/*": ["./modules/infrastructure/src/*"],
      "@genossys-erp/presentation/*": ["./modules/presentation/src/*"],
      "@genossys-erp/ui/*": ["./packages/ui/src/*"]
    }
  }
}
